{
  "name": "evokeeper",
  "version": "0.1.0",
  "private": true,
  "description": "Self-evolving community agent: issue triage & Q&A with an experience CI/CD loop",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "triage:dryrun": "tsx scripts/dryrun-triage.mts",
    "pilot:triage": "tsx scripts/pilot-triage.mts",
    "pilot:answer": "tsx scripts/pilot-answer.mts",
    "lint": "pnpm -r lint",
    "eval:run": "tsx scripts/run-eval.mts",
    "eval:gate": "tsx scripts/gate-check.mts",
    "adversarial:check": "tsx scripts/adversarial-check.mts",
    "scan:daily": "tsx scripts/scan-daily.mts"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "undici": "^8.12.2",
    "vitest": "^5.0.0"
  }
}
