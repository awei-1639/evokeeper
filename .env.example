# EvoKeeper 环境变量样例——复制为 .env.local 并填入真实值（.env.local 不进 git，design.md §9）

# ---- LLM（packages/llm）----
# DeepSeek（分诊/整理档；走公益站时 BASE_URL 覆盖为站点地址）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://<中转站>/v1

# ---- GitHub（apps/agent / scripts）----
GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# PORT=8787

# ---- Postgres（infra 容器：pgvector/pgvector:pg16 @ 5432）----
DATABASE_URL=postgresql://evokeeper:evokeeper_dev_only@localhost:5432/evokeeper

# ---- Redis（infra 容器：redis:7 @ 6379）----
REDIS_URL=redis://localhost:6379

# ---- Langfuse（infra 容器 @ 3001；不配置则观测关闭，主链路不受影响）----
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3001
